<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.HBox?>
<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.leonidasAndrei.asserta.controller.SetupController"
      prefHeight="960" prefWidth="1280"
      fx:id="lobbyWindow">

    <VBox prefWidth="1280.0" prefHeight="960.0" alignment="CENTER">
        <!-- Top Header -->
        <Text text="LOBBY" fx:id="lobbyTitleTxt"/>

        <GridPane fx:id="lobbyGrid" alignment="CENTER" hgap="40" vgap="40" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>
        </GridPane>

        <!-- Bottom Footer -->
        <VBox prefHeight="180.0" alignment="CENTER" spacing="12">
            <padding> <Insets bottom="100"/> </padding>
            <Label fx:id="errorLbl" styleClass="errorLbl"/>
            <Label fx:id="lobbyStatusLbl" text="Waiting for players... (1/4)" styleClass="statusLbl"/>
            <Button text="START" onAction="#onStartClicked" styleClass="menuBtn, successBtn" prefWidth="240.0" prefHeight="55.0"/>
        </VBox>
    </VBox>

    <HBox alignment="TOP_LEFT">
        <padding> <Insets top="54" left="54"/> </padding>
        <Button text="&lt;"
                styleClass="iconBtn, dangerBtn"
                prefWidth="55.0"
                prefHeight="55.0"
                onAction="#onBackClicked" />
    </HBox>

</Pane>