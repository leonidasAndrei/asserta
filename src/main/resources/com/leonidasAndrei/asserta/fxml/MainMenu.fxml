<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>

<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.leonidasAndrei.asserta.controller.MainMenuController"
      prefHeight="960" prefWidth="1280"
      styleClass="main-window">

    <Label text="ASSERTA"
           layoutX="140.0" layoutY="250.0"
           prefWidth="1000.0" alignment="CENTER"
           styleClass="title-label, glow"/>

    <Button text="PLAY"
            onAction="#onPlayClicked"
            layoutX="515.0" layoutY="460.0"
            prefWidth="250.0" prefHeight="50.0"
            styleClass="menu-button"/>

    <Button text="RULES"
            onAction="#onRulesClicked"
            layoutX="515.0" layoutY="534.0"
            prefWidth="250.0" prefHeight="50.0"
            styleClass="menu-button"/>


    <Button text="QUIT"
            onAction="#onExitClicked"
            layoutX="515.0" layoutY="608.0"
            prefWidth="250.0" prefHeight="50.0"
            styleClass="menu-button, danger-button"/>

</Pane>