<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="rootPane"
      fx:controller="com.leonidasAndrei.asserta.controller.GameController"
      prefHeight="960" prefWidth="1280">

    <Pane fx:id="tableFelt" layoutX="140" layoutY="180" prefWidth="1000" prefHeight="600" />
    <Pane fx:id="tableRing" layoutX="165" layoutY="205" prefWidth="950" prefHeight="550" />

    <Button fx:id="settingsButton"
            text="&lt;"
            layoutX="24" layoutY="24"
            onAction="#onSettingsClicked"
            styleClass="menu-btn, utility-btn"
            />

    <Label fx:id="roundLabel" layoutX="940" layoutY="30" prefWidth="300" alignment="CENTER_RIGHT" />

    <StackPane fx:id="deckZone" layoutX="588" layoutY="407" prefWidth="104" prefHeight="146"/>

    <Label fx:id="declaredRankLabel"
           layoutX="440" layoutY="585"
           prefWidth="400"
           alignment="CENTER" />

    <Pane fx:id="seatsPane" layoutX="0" layoutY="0" prefWidth="1280" prefHeight="960"/>

    <HBox fx:id="actionBar"
          layoutX="140" layoutY="770"
          prefWidth="1000"
          alignment="CENTER"
          spacing="24"
          visible="false">

        <Button fx:id="callBluffButton"
                text="⚠  CALL BLUFF"
                onAction="#onCallBluffClicked"
                style="-fx-background-color: #261212; -fx-text-fill: #ff5555; -fx-border-color: #cc3333; -fx-border-width: 1.5; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>

        <HBox fx:id="handBox" alignment="CENTER" spacing="8"/>

        <Button fx:id="playButton"
                text="▶  PLAY CARDS"
                onAction="#onPlayClicked"
                visible="false"
                disable="true"/>
    </HBox>

    <Label fx:id="messageLabel"
           layoutX="390" layoutY="742"
           prefWidth="500"
           alignment="CENTER"
           style="-fx-font-size:11px;-fx-text-fill:#ff5555;-fx-font-family:'Arcade Normal';"
           wrapText="true"
    />

    <StackPane fx:id="bluffOverlay" prefWidth="1280" prefHeight="960" visible="false" mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.85);">
        <Label fx:id="bluffLabel" text="⚠  BLUFF CALLED!"/>
    </StackPane>

    <StackPane fx:id="announcementOverlay" prefWidth="1280" prefHeight="960" visible="false" style="-fx-background-color: rgba(0,0,0,0.85);">
        <Label fx:id="announcementLabel"/>
    </StackPane>

    <StackPane fx:id="cupModal" prefWidth="1280" prefHeight="960" visible="false" style="-fx-background-color: rgba(0,0,0,0.78);">
        <VBox alignment="CENTER" spacing="24" style="-fx-background-color: #101010; -fx-border-color: #c9a84c; -fx-border-width: 1.5; -fx-padding: 44 52; -fx-background-radius: 2; -fx-border-radius: 2; -fx-max-width: 460; -fx-max-height: 260;">
            <Label fx:id="cupModalTitle" wrapText="true" alignment="CENTER" style="-fx-font-size: 16px; -fx-text-fill: #d0c0a0; -fx-font-weight: bold;"/>
            <HBox spacing="24" alignment="CENTER">
                <Button text="✗  WRONG" onAction="#onWrongClicked" style="-fx-background-color:#180808;-fx-text-fill:#ff5555; -fx-border-color:#cc3333;-fx-border-width:1.5;-fx-border-radius:0;-fx-background-radius:0;-fx-font-size:14px;-fx-font-weight:bold;-fx-padding:11 32;-fx-cursor:hand;"/>
                <Button text="✓  RIGHT" onAction="#onRightClicked" style="-fx-background-color:#081408;-fx-text-fill:#55cc77; -fx-border-color:#338844;-fx-border-width:1.5;-fx-border-radius:0;-fx-background-radius:0;-fx-font-size:14px;-fx-font-weight:bold;-fx-padding:11 32;-fx-cursor:hand;"/>
            </HBox>
        </VBox>
    </StackPane>

</Pane>